# 开发期构建资产：源码 / 探针 / 构建脚本纳入版本管理（保留本地历史，便于异地备份）。
# 站点发布仍只用 quiz/index.html 这一个成品 + manifest/sw/icons。
# 截图、日志、临时备份与一次性编辑脚本不入库。
quiz/.build/*
quiz/.build/shots/
quiz/.build/shots10/
!quiz/.build/*.js
!quiz/.build/*.cjs
!quiz/.build/*.mjs
!quiz/.build/*.html
# 排除规则必须放在白名单否定之后，否则会被 !*.cjs 重新纳入
quiz/.build/*.bak*
quiz/.build/*.log
quiz/.build/_edit*.cjs
quiz/.build/_cdp_smoke.cjs
quiz/.build/_c4trace.cjs

# 音频文件体积大（flac/wav 单曲几十 MB），不进仓库
# 想给 PWA 配乐：把 mp3 按 flower-dance/summer/luv-letter/canon 命名，
# 直接放进发布目录 _deploy_gym/quiz/audio/ 即可（sw.js 会按体积挑选预缓存）
quiz/audio/
# 发布目录里的音频同样不进仓库（由 surge 部署带上，避免 80MB+ 入库）
_deploy_gym/quiz/audio/
# brain-gym 背景音乐：原始大格式（flac/wav）不入库，压缩版 mp3 入库（约 9MB，Cloudflare/GitHub Pages 均可播放）
brain-gym/audio/*.flac
brain-gym/audio/*.wav

# 系统/编辑器噪音
.DS_Store
Thumbs.db

# 主控脚本的临时目录（CDP 浏览器 profile / 一次性验证脚本 / 截图）
# 这些不进版本库：profile 有几十 MB 且含本机路径，验证脚本是一次性的
.tmp/

# === 统一大厅构建链（2026-11-08 第二轮）===
# 构建产物不入库：由 `node tools/build.mjs --target=all` 或 serve.bat 一键再生。
# 三形态一致性由 dist.manifest.json / offline.manifest.json 的逐文件 SHA256 校验。
/dist/
/offline/
/dist.manifest.json
/offline.manifest.json
/verify-report.json
node_modules/
# 归档目录只在仓库外（D:\Projects\_archive），不进本仓库
/_archive/