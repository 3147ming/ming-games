# 开发期构建资产：源码 / 探针 / 构建脚本纳入版本管理（保留本地历史，便于异地备份）。
# 站点发布仍只用 quiz/index.html 这一个成品 + manifest/sw/icons。
# 截图、日志、临时备份与一次性编辑脚本不入库。
quiz/.build/*
quiz/.build/shots/
quiz/.build/shots10/
quiz/.build/*.bak*
quiz/.build/*.log
quiz/.build/_edit*.cjs
quiz/.build/_online_verify.cjs
!quiz/.build/*.js
!quiz/.build/*.cjs
!quiz/.build/*.mjs
!quiz/.build/*.html

# 音频文件体积大（flac/wav 单曲几十 MB），不进仓库
# 想给 PWA 配乐：把 mp3 按 flower-dance/summer/luv-letter/canon 命名，
# 直接放进发布目录 _deploy_gym/quiz/audio/ 即可（sw.js 会按体积挑选预缓存）
quiz/audio/
# 发布目录里的音频同样不进仓库（由 surge 部署带上，避免 80MB+ 入库）
_deploy_gym/quiz/audio/
# brain-gym 背景音乐：原始大格式（flac/wav）不入库，压缩版 mp3 入库（约 9MB，Cloudflare/GitHub Pages 均可播放）
brain-gym/audio/*.flac
brain-gym/audio/*.wav

# 系统/编辑器噪音
.DS_Store
Thumbs.db
